datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  tier      String   @default("Artisan Member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  reviews   Review[]
  cart      Cart?
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  flavorId  String
  flavorName String
  quantity  Int
  updatedAt DateTime @updatedAt

  @@unique([cartId, flavorId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName    String
  email           String
  boxSize         String
  totalPrice      Float
  status          String      @default("Cooking & Sealing")
  shippingAddress String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flavorName String
  quantity   Int
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  role      String   @default("Verified Tasting Member")
  rating    Int      @default(5)
  flavor    String
  comment   String
  createdAt DateTime @default(now())
}
